# Copie para ".env" e preencha o que for usar. Nenhuma chave e obrigatoria
# para o pipeline rodar -- o que faltar so vira um aviso no relatorio.

# Petroleo oficial (gratis, cadastro em https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# Refinamento de classificacao via Claude (opcional, mas recomendado
# para reduzir falso-positivo/negativo das regras de palavra-chave)
ANTHROPIC_API_KEY=

# A partir de qual tier (0-4) disparar notificacao. Default = 2.
ALERT_THRESHOLD=2

# --- Canais de notificacao (configure um ou mais) ---

# ntfy.sh: escolha um topico (string unica, dificil de adivinhar).
# Depois se inscreva em https://ntfy.sh/SEU_TOPICO pelo navegador ou app.
NTFY_TOPIC=

# Telegram: crie um bot com @BotFather no Telegram para pegar o token,
# e mande "/start" pro bot antes de pegar o chat_id (via getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: crie um "Incoming Webhook" em Slack App settings.
SLACK_WEBHOOK_URL=

# Discord: Configuracoes do canal -> Integracoes -> Webhooks -> Novo Webhook.
DISCORD_WEBHOOK_URL=
